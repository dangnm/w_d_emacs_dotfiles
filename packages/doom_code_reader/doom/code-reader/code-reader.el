;;; code-reader.el --- Explain code side by side with Claude -*- lexical-binding: t; -*-

;;; Commentary:

;; Doom Code Reader, Phase 1.  Shows a source file on the left and Claude's
;; explanation of the whole file on the right, with synchronised scrolling in
;; both directions.  A selected block or the function at point can be explained
;; on its own as well.
;;
;; The explanations come from a Python engine (the `engine/' directory of the
;; package) that talks to the claude CLI.  Emacs starts the engine on demand and
;; talks to it over a UNIX socket, using the protocol in PROTOCOL.md.
;;
;; Modules:
;;   code-reader-highlight.el   faces, overlays and pure section lookup
;;   code-reader-transport.el   socket connection, engine start, framing
;;   code-reader-session.el     per-view state, requests and engine events
;;   code-reader-ui.el          layout and explanation buffer
;;   code-reader-sync.el        synchronised scrolling and click-to-jump
;;   code-reader-guide.el       key guide shown under the explanation pane
;;   code-reader-chat.el        question box under the explanation, follow-up answers
;;   code-reader-commands.el    interactive commands
;;
;; Key bindings are not defined here.  Bind the commands in your own
;; configuration.  The explanation buffer's own keymap uses RET, mouse-1, g, c,
;; t and q.
;;
;; Load with (require 'code-reader), or autoload the commands from this file.

;;; Code:

(defgroup code-reader nil
  "Side-by-side code explanations generated by Claude."
  :group 'tools
  :prefix "code-reader-")

;;;###autoload
(autoload 'code-reader-open "code-reader" nil t)
;;;###autoload
(autoload 'code-reader-explain-file "code-reader" nil t)
;;;###autoload
(autoload 'code-reader-explain-block "code-reader" nil t)
;;;###autoload
(autoload 'code-reader-explain-function "code-reader" nil t)
;;;###autoload
(autoload 'code-reader-cancel "code-reader" nil t)
;;;###autoload
(autoload 'code-reader-refresh "code-reader" nil t)
;;;###autoload
(autoload 'code-reader-toggle-panel "code-reader" nil t)
;;;###autoload
(autoload 'code-reader-close "code-reader" nil t)
;;;###autoload
(autoload 'code-reader-clear-cache "code-reader" nil t)
;;;###autoload
(autoload 'code-reader-reset-session "code-reader" nil t)
;;;###autoload
(autoload 'code-reader-show-status "code-reader" nil t)
;;;###autoload
(autoload 'code-reader-set-language "code-reader" nil t)
;;;###autoload
(autoload 'code-reader-copy-cache-path "code-reader" nil t)
;;;###autoload
(autoload 'code-reader-shutdown-engine "code-reader" nil t)

(defconst code-reader-package-root
  (let ((file (or load-true-file-name load-file-name buffer-file-name)))
    (if file
        ;; This file lives in <root>/doom/code-reader/.
        (expand-file-name "../.." (file-name-directory (file-truename file)))
      default-directory))
  "Root of the package; the `engine' directory lives in it.")

(defcustom code-reader-python-command "python3"
  "Python executable used to start the engine as `python3 -m engine'."
  :type 'string
  :group 'code-reader)

(defcustom code-reader-claude-command nil
  "Path to the claude CLI.
When nil, use ~/.local/bin/claude if it is executable, else the first
`claude' found on `exec-path'."
  :type '(choice (const :tag "Auto-detect" nil) file)
  :group 'code-reader)

(defcustom code-reader-explain-language "English"
  "Language for explanations, for example \"English\" or \"Vietnamese\"."
  :type 'string
  :group 'code-reader)

(defcustom code-reader-timeout 300
  "Seconds the engine lets one Claude call run before giving up.
A whole-file explanation of a long file can take a few minutes."
  :type 'integer
  :group 'code-reader)

(defcustom code-reader-effort "low"
  "Reasoning effort for each Claude call: low, medium, high, xhigh or max.
Low is several times faster and cheaper than the CLI default, and is enough
for explanations.  The engine reads this when it starts, so run
`code-reader-shutdown-engine' after changing it."
  :type '(choice (const "low") (const "medium") (const "high") (const "xhigh") (const "max"))
  :group 'code-reader)

(defcustom code-reader-model nil
  "Model alias or name passed to Claude, or nil for the CLI default."
  :type '(choice (const :tag "CLI default" nil) string)
  :group 'code-reader)

(defcustom code-reader-state-directory "~/.cache/doom-code-reader/"
  "Directory for the engine's cache, Claude session data and logs."
  :type 'directory
  :group 'code-reader)

(defcustom code-reader-socket-file nil
  "UNIX socket used to reach the engine.
When nil, use engine.sock inside `code-reader-state-directory'.  UNIX
socket paths are limited to about 104 bytes, so keep this path short."
  :type '(choice (const :tag "engine.sock in the state directory" nil) file)
  :group 'code-reader)

(defcustom code-reader-claude-env-remove '("ANTHROPIC_API_KEY")
  "Environment variables removed from the Claude CLI's environment.
Each name is passed to the engine as --drop-env.  The default removes
ANTHROPIC_API_KEY, so that the CLI uses the claude.ai login rather than an API
key that may be exhausted."
  :type '(repeat string)
  :group 'code-reader)

(require 'code-reader-highlight)
(require 'code-reader-transport)
(require 'code-reader-session)
(require 'code-reader-ui)
(require 'code-reader-sync)
(require 'code-reader-guide)
(require 'code-reader-chat)
(require 'code-reader-commands)

(provide 'code-reader)
;;; code-reader.el ends here
